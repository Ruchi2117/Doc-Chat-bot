# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# Documents and vector store
RAG_PROFILE=render
DOCUMENTS_DIR=documents
VECTORSTORE_PATH=vectorstore
AUTO_PREPARE_DOCUMENTS=true
CHROMA_COLLECTION=doc_chatbot
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Set AUTO_PREPARE_DOCUMENTS=false in production if you only want answers
# from files uploaded in the current browser session.

# Full local/pro profile only:
# RAG_PROFILE=full
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DEVICE=cpu

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
